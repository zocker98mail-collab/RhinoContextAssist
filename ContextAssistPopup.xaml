<Window x:Class="RhinoContextAssist.ContextAssistPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <Window.Resources>
        <DropShadowEffect x:Key="S" BlurRadius="18" ShadowDepth="3" Opacity="0.35" />

        <Style x:Key="B" TargetType="Button">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="180" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>

        
    </Window.Resources>

    <!-- ScaleTransform for smooth Ease-Out Entry -->
    <Border x:Name="RootBorder"
            Background="#EF282828"
            CornerRadius="12"
            Padding="5"
            Effect="{StaticResource S}"
            RenderTransformOrigin="0.5, 0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.95" ScaleY="0.95"/>
        </Border.RenderTransform>
        
        <Grid>
            <Button x:Name="Pill"
                    Style="{StaticResource B}"
                    Click="Pill_Click" />

            <StackPanel x:Name="Expanded" Visibility="Collapsed">
                <Grid x:Name="HeaderBar"
                      Margin="2,0,5,2"
                      Background="Transparent"
                      Cursor="SizeAll"
                      MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown"
                      ToolTip="Ziehen zum Verschieben (rastet optional magnetisch an Viewport-Rändern ein)">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Visible Drag Grip -->
                    <TextBlock Grid.Column="0" Text="⋮⋮" Foreground="#777" Margin="4,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                    
                    <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Foreground="#DDD" />

                    <!-- Pin Button -->
                    <Button x:Name="SettingsButton" Grid.Column="2" Content="⚙" Style="{StaticResource B}" Margin="0,0,2,0" ToolTip="Einstellungen öffnen" Click="Settings_Click" />
                    <ToggleButton x:Name="PinButton" Grid.Column="3" Content="📌" 
                                  Background="Transparent" BorderThickness="0" Foreground="#AAA"
                                  Margin="5,0,5,0" Cursor="Hand" ToolTip="Leiste anheften (Auto-Hide und Auswahlaufhebung ignorieren)" />

                    <Button Grid.Column="4" Content="×" Style="{StaticResource B}" ToolTip="Schließen (Esc)" Click="Close_Click" />
                </Grid>

                <StackPanel x:Name="Primary" Orientation="Horizontal" />
                <Button x:Name="LayerButton" Style="{StaticResource B}" HorizontalContentAlignment="Left" Margin="2,4,2,2" Click="LayerButton_Click" ToolTip="Objekt-Layer ändern" />

                <Popup x:Name="More" Placement="Bottom" AllowsTransparency="True" StaysOpen="True" Opened="More_Opened">
                    <Border Background="#FC282828" CornerRadius="10" Padding="6" Effect="{StaticResource S}">
                        <StackPanel Width="310">
                            <TextBox x:Name="SearchBox"
                                     Margin="3" Padding="6"
                                     ToolTip="Befehl nach deutschem Namen, Beschreibung, Kategorie oder englischem Makro suchen"
                                     ToolTipService.InitialShowDelay="180" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowDuration="12000"
                                     TextChanged="SearchBox_TextChanged"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown" />

                            <ScrollViewer x:Name="MoreScrollViewer" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SearchResults" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
                <Popup x:Name="LayerPopup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" Opened="LayerPopup_Opened" Closed="LayerPopup_Closed">
                    <Border x:Name="LayerPopupBorder" Background="#FC282828" CornerRadius="10" Padding="6" Effect="{StaticResource S}">
                        <StackPanel Width="280">
                            <TextBox x:Name="LayerSearchBox"
                                     Margin="3" Padding="6"
                                     ToolTip="Nach Layer-Namen suchen"
                                     TextChanged="LayerSearchBox_TextChanged"
                                     PreviewKeyDown="LayerSearchBox_PreviewKeyDown" />

                            <ScrollViewer x:Name="LayerScrollViewer" MaxHeight="250" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="LayerResults" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>
    </Border>
</Window>
