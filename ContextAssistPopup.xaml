<Window x:Class="RhinoContextAssist.ContextAssistPopup" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" SizeToContent="WidthAndHeight" ResizeMode="NoResize">
 <Window.Resources><DropShadowEffect x:Key="S" BlurRadius="16" ShadowDepth="2" Opacity=".35"/><Style x:Key="B" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="2"/></Style><Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource B}"><Setter Property="Foreground" Value="#FFFFB4B4"/></Style></Window.Resources>
 <Border Background="#ED282828" CornerRadius="12" Padding="5" Effect="{StaticResource S}"><Grid><Button x:Name="Pill" Style="{StaticResource B}" Click="Pill_Click"/><StackPanel x:Name="Expanded" Visibility="Collapsed"><Grid x:Name="Header" Margin="6,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TitleText" Foreground="#DDD"/><Button Grid.Column="1" Content="×" Style="{StaticResource B}" Click="Close_Click"/></Grid><StackPanel x:Name="Primary" Orientation="Horizontal"/><Popup x:Name="More" Placement="Bottom" AllowsTransparency="True" StaysOpen="True"><Border Background="#FA282828" CornerRadius="10" Padding="5" Effect="{StaticResource S}"><StackPanel x:Name="MoreRoot"/></Border></Popup></StackPanel></Grid></Border>
</Window>
