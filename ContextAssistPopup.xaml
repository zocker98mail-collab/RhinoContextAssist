<Window x:Class="RhinoContextAssist.ContextAssistPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Window.Resources>
        <DropShadowEffect x:Key="S"
                          BlurRadius="16"
                          ShadowDepth="2"
                          Opacity="0.35" />

        <Style x:Key="B" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="180" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>

        <Style x:Key="Danger"
               TargetType="Button"
               BasedOn="{StaticResource B}">
            <Setter Property="Foreground" Value="#FFFFB4B4" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#EF282828"
            CornerRadius="12"
            Padding="5"
            Effect="{StaticResource S}">
        <Grid>
            <Button x:Name="Pill"
                    Style="{StaticResource B}"
                    Click="Pill_Click" />

            <StackPanel x:Name="Expanded"
                        Visibility="Collapsed">
                <Grid Margin="5,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleText"
                               VerticalAlignment="Center"
                               Foreground="#DDD" />

                    <Button Grid.Column="1"
                            Content="×"
                            Style="{StaticResource B}"
                            ToolTip="Schließen"
                            Click="Close_Click" />
                </Grid>

                <StackPanel x:Name="Primary"
                            Orientation="Horizontal" />

                <Popup x:Name="More"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       StaysOpen="True">
                    <Border Background="#FC282828"
                            CornerRadius="10"
                            Padding="6"
                            Effect="{StaticResource S}">
                        <StackPanel Width="310">
                            <TextBox x:Name="SearchBox"
                                     Margin="3"
                                     Padding="6"
                                     ToolTip="Befehl nach deutschem Namen, Beschreibung, Kategorie oder englischem Makro suchen"
                                     ToolTipService.InitialShowDelay="180"
                                     ToolTipService.BetweenShowDelay="0"
                                     ToolTipService.ShowDuration="12000"
                                     TextChanged="SearchBox_TextChanged" />

                            <ScrollViewer x:Name="MoreScrollViewer"
                                          MaxHeight="420"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SearchResults" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>
    </Border>
</Window>
