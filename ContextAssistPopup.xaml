<Window x:Class="RhinoContextAssist.ContextAssistPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.34" Color="#000000" />
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F4F4F4"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="11,6"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#2FFFFFFF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#45FFFFFF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="31"/>
        </Style>
        <Style x:Key="MoreItemButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="MinWidth" Value="235"/>
            <Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="Shell" Background="#E5262626" BorderBrush="#35FFFFFF" BorderThickness="1"
                CornerRadius="12" Padding="4" Effect="{StaticResource PopupShadow}">
            <Grid>
                <Button x:Name="PillButton" Style="{StaticResource PillButton}" Click="PillButton_Click"/>
                <StackPanel x:Name="ExpandedPanel" Visibility="Collapsed">
                    <!-- Grid statt DockPanel: Titel dehnt sich, X bleibt garantiert ganz rechts oben. -->
                    <Grid Margin="7,3,4,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="CaptionText" Grid.Column="0" Foreground="#CFF4F4F4"
                                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="CloseButton" Grid.Column="1" Content="×" Width="28" Height="26"
                                Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource PillButton}" Click="CloseButton_Click"/>
                    </Grid>
                    <StackPanel x:Name="PrimaryPanel" Orientation="Horizontal" Margin="2"/>
                    <Popup x:Name="MorePopup" Placement="Bottom" AllowsTransparency="True"
                           StaysOpen="True" PopupAnimation="Fade">
                        <Border Background="#F2262626" BorderBrush="#45FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="4" Effect="{StaticResource PopupShadow}">
                            <StackPanel x:Name="MorePanel"/>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
