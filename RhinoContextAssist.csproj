<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RhinoContextAssist</AssemblyName>
    <RootNamespace>RhinoContextAssist</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon"
                      Version="8.0.23304.9001"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Alte Dateien aus den WPF-Versionen werden nicht mehr kompiliert. -->
    <Compile Remove="**/AssemblyInfo.cs" />
    <Compile Remove="ActionService.cs" />
    <Compile Remove="ContextActionPolicy.cs" />
    <Compile Remove="ContextToolbarForm.cs" />
    <Compile Remove="ContextAssistPopup.xaml.cs" />
    <Page Remove="ContextAssistPopup.xaml" />
  </ItemGroup>
</Project>
