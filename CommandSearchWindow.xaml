<Window x:Class="RhinoContextAssist.CommandSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Context Assist – Befehlssuche" Width="430" Height="500" WindowStartupLocation="CenterOwner" Background="#242424" Foreground="White"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="Query" Padding="8" FontSize="14" TextChanged="Query_TextChanged"/><ListBox x:Name="Results" Grid.Row="1" Margin="0,8,0,0" Background="#242424" Foreground="White" BorderThickness="0" MouseDoubleClick="Results_DoubleClick"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="#B5B5B5" FontSize="11" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Window>
